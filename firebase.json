{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": "npm --prefix \"$RESOURCE_DIR\" run build",
    "ignore": [
      "node_modules",
      ".git"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "taskbuddy-d62a2",
          "appId": "1:1046350224596:android:3d1ed80c62de7c42626f41",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "taskbuddy-d62a2",
          "configurations": {
            "android": "1:1046350224596:android:3d1ed80c62de7c42626f41",
            "web": "1:1046350224596:web:fb261009d72b5814626f41"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
